# Copy to .env and fill in. Every line is optional; CLI flags always win.
# Keys may be written bare (HOST=...) or with the CC_PROXY_ prefix.

# Bind address and port.
HOST=127.0.0.1
PORT=55990

# Default CommandCode API key. A per-request "Authorization: Bearer ..."
# header overrides this on every call.
API_KEY=

# Upstream. The proxy posts to <BASE_URL>/alpha/generate.
BASE_URL=https://api.commandcode.ai

# Model mapping file. Leave empty to use ./models.json next to the source tree.
MODELS_FILE=

# Pin x-command-code-version. Empty means "query the npm registry and cache
# for 30 minutes". Useful when the registry is unreachable or you want the
# header to be deterministic.
COMMAND_CODE_VERSION=

# Zero data retention: sends "x-cmd-zdr: 1" on every upstream request, the
# wire form of the CLI's CMD_ZDR=1. The upstream will not retain or train on
# prompts when this is set.
ZDR=false

# DEBUG=true logs full inbound and upstream request bodies (capped at
# 20000 chars each).
DEBUG=false
